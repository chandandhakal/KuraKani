# Pusher credentials — sign up free at https://pusher.com
# Create an app → Channels → copy these values from App Keys tab

PUSHER_APP_ID=your_app_id
PUSHER_SECRET=your_secret

# These two are exposed to the browser (NEXT_PUBLIC_ prefix)
NEXT_PUBLIC_PUSHER_KEY=your_key
NEXT_PUBLIC_PUSHER_CLUSTER=your_cluster   # e.g. ap2, us2, eu

# Firebase credentials — sign up free at https://firebase.google.com
# Create a project → Add Web App → copy these values from SDK config

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
